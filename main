          <button data-act="set-mode" data-mode="group" class="card card-hover mode-card ${STATE.mode === 'group' ? 'active' : ''}">
            <div class="flex-between" style="margin-bottom:0.85rem;">
              <span class="tile-num">Mode 02</span>
              <span class="pill-tag ${STATE.mode === 'group' ? 'pill-ink' : 'pill-sage'}">${STATE.mode === 'group' ? 'Selected' : 'Choose'}</span>
