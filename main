function renderStepper(currentStep) {
  const steps = [
    { n: '01', step: 1, id: 'home', label: 'Overview' },
    { n: '02', step: 2, id: 'preference', label: 'Preferences' },
    { n: '03', step: 3, id: 'location', label: 'Building & Floor' },
    { n: '04', step: 4, id: 'occupancy', label: 'Chair Matrix' },
    { n: '05', step: 5, id: 'details', label: 'Space Details' },
    { n: '06', step: 6, id: 'final', label: 'Final Pass' }
  ];
  return `
    <div class="card stepper-card">
      <div class="stepper-row">
        ${steps.map((st, idx) => {
          const cls = st.step === currentStep ? 'current' : st.step < currentStep ? 'done' : '';
          return `
            <button data-go="${st.id}" class="step-btn ${cls}">
              <span class="step-num">${st.step < currentStep ? '✓' : st.n}</span>
              <span class="step-text">${st.label}</span>
            </button>
            ${idx < steps.length - 1 ? `<div class="step-line ${st.step < currentStep ? 'done' : ''}"></div>` : ''}
          `;
        }).join('')}
      </div>
    </div>
  `;
}

