const SPACES = RAW_SPACES.map((row, idx) => {
  const [id, bld, floor, name, type, audience, total, free, noise, facilities, desc] = row;
  const zone = String.fromCharCode(65 + (idx % 12));
  const chairs = Array.from({ length: total }, (_, i) => {
    const hash = (i * 7 + idx * 5) % total;
    let status = hash < free ? 'vacant' : 'booked';
    if (status === 'booked' && i % 7 === 0) status = 'expiring';
    const num = String(i + 1).padStart(2, '0');
    return { id: `${id}-c${i + 1}`, code: `${zone}-${num}`, status };
  });
  return { id, bld, floor, name, type, audience, total, noise, facilities, desc, chairs };
});

