              </div>
            </div>
            <div>
              <h4 class="footer-h">Campus Blocks</h4>
              <div class="footer-links">
                ${BUILDINGS.map(b => `<button data-act="jump-bld" data-bld="${b.id}" class="footer-link">${b.name} (${b.block})</button>`).join('')}
              </div>
            </div>
            <div>
