const getProfile = () => PROFILES[STATE.role];
const getBuilding = (id) => BUILDINGS.find(b => b.id === id) || BUILDINGS[0];
const getSpace = (id) => SPACES.find(s => s.id === id) || SPACES[0];
const accessibleSpaces = (list) => list.filter(s => STATE.role === 'faculty' || s.audience === 'both');
const countVacant = (sp) => sp.chairs.filter(c => c.status === 'vacant').length;
const countBooked = (sp) => sp.chairs.filter(c => c.status !== 'vacant').length;
const sumBy = (arr, fn) => arr.reduce((acc, item) => acc + fn(item), 0);

function spaceMatchesPreference(sp) {
  if (STATE.mode === 'solo') {
    if (sp.type !== 'solo') return false;
    return STATE.noise === 'Any' || sp.noise === STATE.noise;
  }
  return sp.type === 'group' && countVacant(sp) >= Math.min(STATE.groupSize, sp.total);
}

function getBookFine(book) {
  if (book.finePaid || book.dueOffset >= 0) return 0;
  return Math.abs(book.dueOffset) * 5;
}

function getBookStatus(book) {
  if (book.dueOffset < 0 && !book.finePaid) return { label: 'Overdue', key: 'overdue', cls: 'pill-booked' };
  if (book.dueOffset < 0 && book.finePaid) return { label: 'Fine Paid', key: 'paid', cls: 'pill-sage' };
  if (book.dueOffset <= 3) return { label: 'Due Soon', key: 'soon', cls: 'pill-amber' };
  return { label: 'On Time', key: 'ok', cls: 'pill-vacant' };
}

function getAllReminders() {
  const auto = [];
  STATE.books.forEach(b => {
    const fine = getBookFine(b);
    if (b.dueOffset < 0 && !b.finePaid) {
      const id = `auto-ov-${b.id}`;
      if (!STATE.dismissedAutoIds.includes(id)) {
        const dCount = Math.abs(b.dueOffset);
        auto.push({ id, auto: true, urgent: 'overdue', category: 'Fine Payment', title: `${b.title} is overdue by ${dCount} ${dCount === 1 ? 'day' : 'days'} (Fine ₹${fine})`, when: `Due ${fmtShortDate(addDays(b.dueOffset))}` });
      }
    } else if (b.dueOffset >= 0 && b.dueOffset <= 3) {
      const id = `auto-soon-${b.id}`;
      if (!STATE.dismissedAutoIds.includes(id)) {
        auto.push({ id, auto: true, urgent: 'soon', category: 'Book Due', title: `${b.title} is due ${b.dueOffset === 0 ? 'today' : 'in ' + b.dueOffset + (b.dueOffset === 1 ? ' day' : ' days')}`, when: `Due ${fmtShortDate(addDays(b.dueOffset))}` });
      }
    }
  });
  STATE.bookings.forEach(bk => {
    const id = `auto-bk-${bk.bookingId}`;
    if (!STATE.dismissedAutoIds.includes(id)) {
      auto.push({ id, auto: true, urgent: 'booking', category: 'Study Session', title: `Seat ${bk.chairCode} reserved at ${bk.spaceName} (${bk.buildingName}, Floor ${bk.floor})`, when: bk.slot });
    }
  });
  const custom = STATE.customReminders.filter(r => !r.done).map(r => ({ ...r, auto: false, urgent: 'custom' }));
  return [...auto, ...custom];
}

function getUrgentBadgeCount() {
  const overdueBooks = STATE.books.filter(b => b.dueOffset < 0 && !b.finePaid).length;
  const dueSoonBooks = STATE.books.filter(b => b.dueOffset >= 0 && b.dueOffset <= 3).length;
  return overdueBooks + dueSoonBooks;
}

function showToast(title, subtitle = '', tone = 'sage') {
  const container = document.getElementById('toast-container');
  const el = document.createElement('div');
  el.className = `toast-item ${tone} view-enter`;
  el.innerHTML = `<div class="bold" style="font-size:0.84rem;color:var(--ink-900);">${title}</div>${subtitle ? `<div class="text-xs muted" style="margin-top:2px;">${subtitle}</div>` : ''}`;
  container.appendChild(el);
  setTimeout(() => {
    el.style.opacity = '0';
    el.style.transform = 'translateY(-8px)';
    setTimeout(() => el.remove(), 240);
  }, 3400);
}

function chairSvg(status) {
  return `
    <svg viewBox="0 0 32 32" fill="none" stroke="currentColor" stroke-width="2">
      <path d="M6 6h20" stroke-linecap="round" stroke-width="2.2" opacity="0.45"/>
      <rect x="8" y="11" width="16" height="11" rx="3.5" fill="currentColor" fill-opacity="0.16"/>
      <path d="M7 25c3 2.5 15 2.5 18 0" stroke-linecap="round" stroke-width="2.3"/>
      <path d="M6.5 13v6M25.5 13v6" stroke-linecap="round"/>
      ${status === 'booked' ? '<path d="M13 14l6 5M19 14l-6 5" stroke-width="2" stroke-linecap="round"/>' : ''}
      ${status === 'selected' ? '<path d="M12.5 16.5l2.5 2.5 5-5" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"/>' : ''}
      ${status === 'expiring' ? '<circle cx="16" cy="16.5" r="2.2" fill="currentColor"/>' : ''}
    </svg>
  `;
}

