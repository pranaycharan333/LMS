            <div class="flex-between" style="margin-bottom:0.85rem;">
              <span class="tile-num">Mode 01</span>
              <span class="pill-tag ${STATE.mode === 'solo' ? 'pill-ink' : 'pill-sage'}">${STATE.mode === 'solo' ? 'Selected' : 'Choose'}</span>
