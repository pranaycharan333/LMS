              `).join('')}
            </div>
          ` : `
            <span class="eyebrow-label" style="color:var(--ink-500);margin-bottom:0.85rem;">3. Group Size</span>
            <div class="chip-row">
              ${[2, 4, 6, 8].map(sz => `
                <button data-act="set-size" data-val="${sz}" class="chip-btn ${STATE.groupSize === sz ? 'active' : ''}">${sz} People</button>
              `).join('')}
            </div>
          `}
          ${STATE.role === 'faculty' ? `<div style="margin-top:1rem;padding:0.75rem 1rem;border-radius:12px;background:var(--bg-sage-tint);border:1px solid var(--sage-200);font-size:0.76rem;color:var(--sage-700);">Faculty Mode Active: Dedicated <strong>Faculty Research Carrels</strong> and <strong>Seminar Suites</strong> are unlocked in the floor maps.</div>` : ''}
        </div>

        <div class="flex-between">
