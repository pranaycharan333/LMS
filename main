        </div>
      </div>
    `;
  },

  location() {
    const selectedBld = getBuilding(STATE.buildingId);
    return `
      <div class="view-enter">
        ${renderStepper(3)}
        ${demoNoticeBar(`<button data-act="refresh-demo" class="btn-secondary btn-sm">↻ Refresh Sample Counts</button>`)}

        <div class="page-head">
          <div>
            <span class="eyebrow-label">Step 03 of 06 · Building &amp; Floor Selection (${STATE.mode === 'solo' ? 'Solo · ' + STATE.noise : 'Group of ' + STATE.groupSize})</span>
            <h1 class="page-title">Select a Campus Building &amp; Floor</h1>
          </div>
          <div style="display:flex;flex-wrap:wrap;gap:0.5rem;">
            <button data-go="preference" class="btn-secondary btn-sm">← Change Preferences</button>
            <button data-go="occupancy" class="btn-primary btn-sm">Open ${selectedBld.name}, Floor ${STATE.floor} →</button>
          </div>
        </div>

        <div class="instruction-banner">
          <div style="display:flex;align-items:center;gap:0.8rem;">
            <span class="step-badge-circle">03</span>
            <div>
              <div class="semibold text-sm" style="color:var(--ink-900);">Select a building, then choose a floor to view available study spaces.</div>
              <div class="text-xs muted" style="margin-top:2px;">Currently selected: <strong style="color:var(--ink-900);">${selectedBld.name} (${selectedBld.block}) · Floor ${STATE.floor}</strong></div>
            </div>
          </div>
          <div class="chip-row">
            ${BUILDINGS.map(b => `
              <button data-act="focus-bld" data-bld="${b.id}" class="chip-btn" style="padding:0.36rem 0.85rem;font-size:0.72rem;${b.id === STATE.buildingId ? 'background:var(--ink-800);color:#FFFFFF;border-color:var(--ink-800);' : ''}">${b.block}</button>
            `).join('')}
          </div>
        </div>

        <div class="grid-2" style="margin-bottom:1.5rem;">
          ${BUILDINGS.map((b, bIdx) => {
            const bSpaces = accessibleSpaces(SPACES.filter(s => s.bld === b.id));
            const total = sumBy(bSpaces, s => s.total);
            const vacant = sumBy(bSpaces, countVacant);
            const booked = total - vacant;
            const isSelectedBld = b.id === STATE.buildingId;
            return `
              <div class="card building-card ${isSelectedBld ? 'active' : ''}">
                <div class="building-head">
                  <div>
                    <div style="display:flex;flex-wrap:wrap;align-items:center;gap:0.45rem;margin-bottom:0.4rem;">
                      <span class="tile-num" style="font-size:1rem;">0${bIdx + 1}</span>
                      <span class="pill-tag pill-sage">${b.block} · ${b.tag}</span>
                      ${isSelectedBld ? `<span class="pill-tag pill-ink">Selected Building</span>` : ''}
                    </div>
                    <h2 style="font-size:1.45rem;font-weight:500;">${b.name}</h2>
                    <p class="text-xs muted" style="margin-top:0.3rem;line-height:1.55;">${b.desc}</p>
                    <div class="hours-chip">
                      <span>Building Operating Hours (Sample): <strong style="color:var(--ink-900);">${b.hours}</strong></span>
                    </div>
                  </div>
                  <div style="text-align:right;flex-shrink:0;">
                    <span class="pill-tag pill-vacant">${vacant} Vacant</span>
                    <div class="text-xs semibold" style="color:var(--rose-dark);margin-top:0.35rem;">${booked} Occupied</div>
                  </div>
                </div>

                <div class="floor-stack">
                  <div class="floor-stack-label">
                    <span>Choose a Floor in ${b.block}</span>
                    <span>${b.floors.length} Floors</span>
                  </div>
                  <div>
                    ${[...b.floors].reverse().map(fl => {
                      const flSp = bSpaces.filter(s => s.floor === fl);
                      const flVac = sumBy(flSp, countVacant);
                      const flTot = sumBy(flSp, s => s.total);
                      const matchCount = flSp.filter(spaceMatchesPreference).length;
                      const isSelectedFloor = isSelectedBld && STATE.floor === fl;
                      return `
                        <button data-act="enter-floor" data-bld="${b.id}" data-fl="${fl}" class="floor-btn ${isSelectedFloor ? 'active' : ''}">
                          <div style="display:flex;align-items:center;gap:0.75rem;min-width:0;">
                            <span class="floor-circle">F${fl}</span>
                            <div style="min-width:0;">
                              <div style="display:flex;flex-wrap:wrap;align-items:center;gap:0.4rem;font-size:0.84rem;font-weight:700;color:var(--ink-900);">
                                <span>Floor ${fl}</span>
                                ${isSelectedFloor ? `<span class="pill-tag pill-ink" style="font-size:0.65rem;padding:0.15rem 0.55rem;">Selected</span>` : ''}
                                ${matchCount > 0 ? `<span class="pill-tag pill-sage" style="font-size:0.65rem;padding:0.15rem 0.55rem;">${matchCount} match</span>` : ''}
                              </div>
                              <div class="text-xs muted" style="margin-top:2px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;">${flSp.map(s => s.name).join(' · ')}</div>
                            </div>
                          </div>
                          <div style="text-align:right;flex-shrink:0;">
                            <div class="text-xs bold" style="color:${flVac > 5 ? 'var(--emerald-dark)' : 'var(--amber-dark)'};">${flVac} of ${flTot} vacant</div>
                            <div class="text-xs semibold" style="color:var(--sage-700);">View Seats →</div>
                          </div>
                        </button>
                      `;
                    }).join('')}
                  </div>
                </div>
              </div>
            `;
          }).join('')}
        </div>

        <div class="flex-between">
          <button data-go="preference" class="btn-secondary">← Back to Study Preferences</button>
          <button data-go="occupancy" class="btn-primary">View Floor ${STATE.floor} Seat Availability →</button>
        </div>
      </div>
    `;
  },

  occupancy() {
    const bld = getBuilding(STATE.buildingId);
    const flSpacesAll = accessibleSpaces(SPACES.filter(s => s.bld === bld.id && s.floor === STATE.floor));
    const flSpacesFiltered = flSpacesAll.filter(sp => {
      if (STATE.floorFilter === 'match') return spaceMatchesPreference(sp);
      if (STATE.floorFilter === 'vacant') return countVacant(sp) > 0;
      return true;
    });
    const displaySpaces = flSpacesFiltered.length ? flSpacesFiltered : flSpacesAll;
    if (!displaySpaces.some(s => s.id === STATE.activeSpaceId) && displaySpaces.length) {
      STATE.activeSpaceId = displaySpaces[0].id;
    }
    const activeSp = getSpace(STATE.activeSpaceId);

    const flTotal = sumBy(flSpacesAll, s => s.total);
    const flVacant = sumBy(flSpacesAll, countVacant);
    const flBooked = flTotal - flVacant;
    const matchCount = flSpacesAll.filter(spaceMatchesPreference).length;

    return `
      <div class="view-enter">
        ${renderStepper(4)}

        <div class="card" style="padding:1.1rem 1.25rem;margin-bottom:1.25rem;">
          <div class="flex-between" style="padding-bottom:0.85rem;border-bottom:1px solid #E9EFEA;margin-bottom:0.85rem;">
            <div style="display:flex;flex-wrap:wrap;align-items:center;gap:0.5rem;font-size:0.78rem;">
              <button data-go="location" class="btn-secondary btn-sm">← Change Building / Floor</button>
              <span class="subtle">›</span>
              <strong style="color:var(--ink-900);">${bld.name} (${bld.block})</strong>
              <span class="subtle">›</span>
              <span class="pill-tag pill-sage">Floor ${STATE.floor}</span>
            </div>
            <div class="text-xs muted">
              Building Operating Hours (Sample): <strong style="color:var(--ink-900);">${bld.hours}</strong>
            </div>
          </div>

          <div class="flex-between">
            <div style="display:flex;flex-wrap:wrap;align-items:center;gap:0.4rem;">
              <span class="eyebrow-label" style="margin:0 0.25rem 0 0;color:var(--ink-500);">Building:</span>
              ${BUILDINGS.map(b => `
                <button data-act="switch-bld-quick" data-bld="${b.id}" class="chip-btn" style="padding:0.35rem 0.85rem;font-size:0.74rem;${b.id === bld.id ? 'background:var(--ink-800);color:#FFFFFF;border-color:var(--ink-800);' : ''}">${b.name.split(' ')[0]} (${b.block})</button>
              `).join('')}
            </div>

            <div class="role-switch">
              <span class="text-xs subtle" style="padding:0 0.55rem;font-weight:600;">Floor:</span>
              ${bld.floors.map(f => `
                <button data-act="enter-floor" data-bld="${bld.id}" data-fl="${f}" class="role-btn ${f === STATE.floor ? 'active' : ''}">Floor ${f}</button>
              `).join('')}
            </div>
          </div>
        </div>

        ${demoNoticeBar(`<button data-act="refresh-demo" class="btn-secondary btn-sm">↻ Refresh Sample Counts</button>`)}

        <div class="grid-4" style="margin-bottom:1.25rem;">
          <div class="card kpi-card">
            <div class="kpi-label">Total Sample Seats (Floor ${STATE.floor})</div>
            <div class="kpi-val">${flTotal}</div>
          </div>
          <div class="card kpi-card">
            <div class="kpi-label">Vacant Seats (Sample)</div>
            <div class="kpi-val" style="color:var(--emerald-dark);">${flVacant}</div>
          </div>
          <div class="card kpi-card">
            <div class="kpi-label">Occupied Seats (Sample)</div>
            <div class="kpi-val" style="color:var(--rose-dark);">${flBooked}</div>
          </div>
          <div class="card kpi-card">
            <div class="kpi-label">Matching Spaces</div>
            <div class="kpi-val" style="color:var(--sage-600);">${matchCount} of ${flSpacesAll.length}</div>
          </div>
        </div>

        <div class="flex-between" style="margin-bottom:1rem;">
          <div class="chip-row">
            ${[
              ['all', 'All Spaces on Floor ' + STATE.floor],
              ['match', 'Matching Preference'],
              ['vacant', 'Vacant Only']
            ].map(([k, lbl]) => `
              <button data-act="set-floor-filter" data-val="${k}" class="chip-btn ${STATE.floorFilter === k ? 'active' : ''}">${lbl}</button>
            `).join('')}
          </div>

          <div style="display:flex;flex-wrap:wrap;gap:0.45rem;">
            <span class="pill-tag pill-vacant">● Vacant (Click to Select)</span>
            <span class="pill-tag pill-booked">● Occupied</span>
            <span class="pill-tag" style="background:#EFF6FF;color:#1D4ED8;border:1px solid #93C5FD;">● Selected</span>
            <span class="pill-tag pill-amber">● Reserved</span>
          </div>
        </div>

        <span class="eyebrow-label" style="color:var(--ink-500);margin-bottom:0.55rem;">Study Spaces on Floor ${STATE.floor} — Select a Room</span>
        <div class="chip-row" style="margin-bottom:1.25rem;">
          ${displaySpaces.map(sp => {
            const active = sp.id === activeSp.id;
            return `
              <button data-act="select-space" data-sp="${sp.id}" class="space-tab ${active ? 'active' : ''}">
                <div style="display:flex;align-items:center;gap:0.45rem;">
                  <span class="bold text-sm">${sp.name}</span>
                  ${sp.audience === 'faculty' ? `<span class="pill-tag pill-sage" style="font-size:0.65rem;padding:0.1rem 0.5rem;">Faculty</span>` : ''}
                </div>
                <div class="text-xs" style="margin-top:2px;opacity:0.8;">${sp.type === 'solo' ? 'Solo Study' : 'Group Study'} · ${sp.noise} · ${countVacant(sp)} vacant</div>
              </button>
            `;
          }).join('')}
        </div>

        <div class="card" style="padding:1.5rem;">
          <div class="flex-between" style="padding-bottom:1rem;border-bottom:1px solid #E9EFEA;margin-bottom:1.25rem;">
            <div>
              <h2 style="font-size:1.5rem;font-weight:500;">${activeSp.name} — Sample Desk &amp; Chair Map</h2>
              <p class="text-xs muted" style="margin-top:0.25rem;">${activeSp.desc}</p>
            </div>
            <div style="display:flex;gap:0.5rem;">
              <span class="pill-tag pill-vacant">${countVacant(activeSp)} Vacant</span>
              <span class="pill-tag pill-booked">${countBooked(activeSp)} Occupied</span>
            </div>
          </div>

          <div class="grid-2">
            ${[0, 1].map(tableIdx => {
              const half = Math.ceil(activeSp.chairs.length / 2);
              const slice = activeSp.chairs.slice(tableIdx * half, (tableIdx + 1) * half);
              if (!slice.length) return '';
              return `
                <div class="table-zone">
                  <div class="flex-between" style="margin-bottom:0.75rem;">
                    <span class="eyebrow-label" style="margin:0;color:var(--ink-500);">Study Table Zone ${tableIdx + 1}</span>
                    <span class="text-xs semibold" style="color:var(--sage-700);">${slice.filter(c => c.status === 'vacant').length} vacant</span>
                  </div>
                  <div class="chair-grid-4" style="background:transparent;border:none;padding:0;">
                    ${slice.map(ch => {
                      const isSel = STATE.selectedChair && STATE.selectedChair.chairId === ch.id;
                      const visual = isSel ? 'selected' : ch.status;
                      const disabled = ch.status !== 'vacant' && !isSel;
                      return `
                        <button type="button" ${disabled ? 'disabled' : `data-act="pick-chair" data-sp="${activeSp.id}" data-ch="${ch.id}" data-code="${ch.code}"`} class="chair-tile ${visual}">
                          ${chairSvg(visual)}
                          <span class="chair-code">Seat ${ch.code}</span>
                        </button>
                      `;
                    }).join('')}
                  </div>
                </div>
              `;
            }).join('')}
          </div>

          <div class="flex-between" style="margin-top:1.5rem;padding-top:1.25rem;border-top:1px solid #E9EFEA;">
            <div class="text-sm">
              ${STATE.selectedChair && STATE.selectedChair.spaceId === activeSp.id
                ? `<span class="muted">Selected Seat:</span> <strong style="padding:0.25rem 0.75rem;border-radius:999px;background:var(--blue-ink);color:#FFFFFF;font-size:0.78rem;margin-left:4px;">Seat ${STATE.selectedChair.code}</strong> <span class="muted" style="margin-left:4px;">in ${activeSp.name}</span>`
                : `<span class="muted">Click any <strong style="color:var(--emerald-dark);">green vacant chair</strong> to pick your exact seat, then view full space details.</span>`}
            </div>
            <div style="display:flex;flex-wrap:wrap;gap:0.6rem;">
              <button data-go="location" class="btn-secondary btn-sm">← Change Building / Floor</button>
              <button data-act="open-details" data-sp="${activeSp.id}" class="btn-primary">
                Next: Space Details &amp; Study Session →
              </button>
            </div>
          </div>
        </div>
      </div>
    `;
  },

  details() {
    const sp = getSpace(STATE.activeSpaceId);
    const bld = getBuilding(sp.bld);
    if (!STATE.selectedChair || STATE.selectedChair.spaceId !== sp.id) {
      const first = sp.chairs.find(c => c.status === 'vacant');
      if (first) STATE.selectedChair = { spaceId: sp.id, chairId: first.id, code: first.code };
    }

    return `
      <div class="view-enter" style="max-width:1040px;margin:0 auto;">
        ${renderStepper(5)}
        ${demoNoticeBar()}

        <div class="page-head">
          <div>
            <span class="eyebrow-label">Step 05 of 06 · Study Space Details</span>
            <h1 class="page-title">${sp.name}</h1>
            <div style="display:flex;flex-wrap:wrap;align-items:center;gap:0.5rem;margin-top:0.5rem;font-size:0.84rem;">
              <strong style="color:var(--ink-900);">${bld.name} (${bld.block}) · Floor ${sp.floor}</strong>
              <span class="subtle">·</span>
              <span class="pill-tag pill-sage">Building Operating Hours (Sample): <strong>${bld.hours}</strong></span>
            </div>
          </div>
        </div>

        <div class="split-12 ratio-7-5">
          <div class="stack-lg">
            <div class="card" style="padding:1.5rem;">
              <h2 style="font-size:1.3rem;font-weight:500;margin-bottom:0.5rem;">Environment &amp; Sample Seat Availability</h2>
              <p class="text-sm muted" style="line-height:1.6;margin-bottom:1rem;">${sp.desc}</p>
              <div class="grid-2" style="gap:0.75rem;">
                <div style="padding:0.75rem 1rem;border-radius:12px;background:var(--bg-subtle);border:1px solid var(--border-sage);display:flex;justify-content:space-between;font-size:0.8rem;">
                  <span class="subtle">Study Mode</span><strong>${sp.type === 'solo' ? 'Solo Study' : 'Group Study'}</strong>
                </div>
                <div style="padding:0.75rem 1rem;border-radius:12px;background:var(--bg-subtle);border:1px solid var(--border-sage);display:flex;justify-content:space-between;font-size:0.8rem;">
                  <span class="subtle">Noise Level</span><strong>${sp.noise}</strong>
                </div>
                <div style="padding:0.75rem 1rem;border-radius:12px;background:var(--emerald-soft);border:1px solid var(--emerald-border);display:flex;justify-content:space-between;font-size:0.8rem;color:var(--emerald-dark);">
                  <span>Vacant Chairs (Sample)</span><strong>${countVacant(sp)} of ${sp.total}</strong>
                </div>
                <div style="padding:0.75rem 1rem;border-radius:12px;background:var(--rose-soft);border:1px solid var(--rose-border);display:flex;justify-content:space-between;font-size:0.8rem;color:var(--rose-dark);">
                  <span>Occupied Chairs (Sample)</span><strong>${countBooked(sp)}</strong>
                </div>
              </div>
            </div>

            <div class="card" style="padding:1.5rem;">
              <h2 style="font-size:1.3rem;font-weight:500;margin-bottom:0.85rem;">Facilities Available in This Space</h2>
              <div class="grid-3" style="gap:0.65rem;">
                ${sp.facilities.map(f => `
                  <div style="padding:0.65rem 0.85rem;border-radius:12px;background:var(--bg-subtle);border:1px solid var(--border-sage);display:flex;align-items:center;gap:0.5rem;font-size:0.78rem;font-weight:600;">
                    <span>${facilityIcon(f)}</span>
                    <span>${f}</span>
                  </div>
                `).join('')}
              </div>
            </div>

            <div class="card" style="padding:1.5rem;">
              <div class="flex-between" style="margin-bottom:0.85rem;">
                <h2 style="font-size:1.3rem;font-weight:500;">Mini Chair Preview (Sample)</h2>
                <span class="text-xs semibold" style="color:var(--sage-700);">Tap a green chair to switch</span>
              </div>
              <div class="chair-grid-4" style="grid-template-columns:repeat(auto-fill,minmax(68px,1fr));background:transparent;border:none;padding:0;">
                ${sp.chairs.map(ch => {
                  const isSel = STATE.selectedChair && STATE.selectedChair.chairId === ch.id;
                  const visual = isSel ? 'selected' : ch.status;
                  const disabled = ch.status !== 'vacant' && !isSel;
                  return `
                    <button type="button" ${disabled ? 'disabled' : `data-act="pick-chair" data-sp="${sp.id}" data-ch="${ch.id}" data-code="${ch.code}"`} class="chair-tile ${visual}" style="padding:0.5rem 0.25rem;">
                      <span class="chair-code">${ch.code}</span>
                    </button>
                  `;
                }).join('')}
              </div>
            </div>
          </div>

          <div class="card" style="padding:1.5rem;position:sticky;top:88px;">
            <div style="padding-bottom:0.85rem;border-bottom:1px solid #E9EFEA;">
              <h2 style="font-size:1.35rem;font-weight:500;">Select Study Session Time Slot</h2>
              <p class="text-xs muted" style="margin-top:0.25rem;">Choose your study window within building operating hours (${bld.hours}).</p>
            </div>

            <div style="margin:1rem 0;padding:0.95rem 1rem;border-radius:14px;background:var(--bg-sage-tint);border:1px solid var(--sage-200);display:flex;align-items:center;justify-content:space-between;">
              <div>
                <span class="eyebrow-label" style="margin-bottom:2px;color:var(--sage-700);">Chosen Seat</span>
                <div class="font-serif" style="font-size:1.55rem;font-weight:500;">${STATE.selectedChair ? 'Seat ' + STATE.selectedChair.code : 'No Vacant Seat'}</div>
              </div>
              <div style="text-align:right;font-size:0.78rem;">
                <div class="bold">${getProfile().name}</div>
                <div class="muted">${getProfile().idNumber}</div>
              </div>
            </div>

            <div class="stack-sm" style="margin-bottom:1.25rem;">
              ${TIME_SLOTS.map(sl => `
                <button data-act="set-slot" data-val="${sl}" class="slot-btn ${STATE.timeSlot === sl ? 'active' : ''}">
                  <span>${sl}</span>
                  ${STATE.timeSlot === sl ? '<span>✓</span>' : ''}
                </button>
              `).join('')}
            </div>

            <button data-act="proceed-final" class="btn-primary" style="width:100%;margin-bottom:0.65rem;">
              Generate Digital Seat Pass →
            </button>
            <button data-go="occupancy" class="btn-secondary" style="width:100%;">
              ← Back to Chair Matrix
            </button>
          </div>
        </div>
      </div>
    `;
  },

  final() {
    const pass = STATE.lastPass || STATE.bookings[0];
    if (!pass) {
      return `
        <div class="view-enter" style="max-width:560px;margin:0 auto;">
          ${renderStepper(6)}
          <div class="card" style="padding:2.25rem;text-align:center;">
            <div class="tile-num" style="margin-bottom:0.5rem;">Step 06</div>
            <h2 style="font-size:1.6rem;font-weight:500;margin-bottom:0.5rem;">No Study Space Selected Yet</h2>
            <p class="text-sm muted" style="margin-bottom:1.25rem;">Pick a building floor and select a vacant chair to generate your sample Digital Seat Pass.</p>
            <button data-go="location" class="btn-primary">Explore Campus Buildings →</button>
          </div>
        </div>
      `;
    }

    const isSaved = STATE.bookings.some(b => b.bookingId === pass.bookingId);
    const bld = getBuilding(pass.buildingId);

    return `
      <div class="view-enter narrow-wrap">
        ${renderStepper(6)}
        ${demoNoticeBar()}

        <div class="page-head">
          <div>
            <span class="eyebrow-label">Step 06 of 06 · ${isSaved ? 'Saved to Your Profile' : 'Ready to Confirm'}</span>
            <h1 class="page-title">Digital Study-Space Pass (Demo)</h1>
          </div>
        </div>

        <div class="card" style="overflow:hidden;margin-bottom:1.5rem;">
          <div style="background:var(--ink-800);color:#FFFFFF;padding:1.25rem 1.5rem;display:flex;flex-wrap:wrap;align-items:center;justify-content:space-between;gap:0.75rem;">
            <div>
              <div style="font-size:0.68rem;text-transform:uppercase;letter-spacing:0.14em;color:#B8CEC3;">LPU Sample Seat Pass · ${pass.bookingId}</div>
              <div class="font-serif" style="font-size:1.55rem;font-weight:500;color:#FFFFFF;margin-top:2px;">${pass.spaceName} — Seat ${pass.chairCode}</div>
            </div>
            <span class="pill-tag" style="background:${isSaved ? 'var(--emerald-ink)' : 'var(--sage-600)'};color:#FFFFFF;">${isSaved ? 'Confirmed & Saved' : 'Pending Confirmation'}</span>
          </div>

          <div style="padding:1.5rem;" class="split-12 ratio-8-4">
            <div class="kv-list">
              <div class="kv-row"><span class="kv-label">Reserved For</span><span class="kv-val">${pass.userName} (${pass.userId})</span></div>
              <div class="kv-row"><span class="kv-label">Location</span><span class="kv-val">${pass.buildingName} (${pass.block}), Floor ${pass.floor}</span></div>
              <div class="kv-row"><span class="kv-label">Building Operating Hours (Sample)</span><span class="kv-val">${bld.hours}</span></div>
              <div class="kv-row"><span class="kv-label">Room &amp; Seat</span><span class="kv-val" style="color:var(--sage-700);">${pass.spaceName} · Seat ${pass.chairCode}</span></div>
              <div class="kv-row"><span class="kv-label">Selected Study Session</span><span class="kv-val">${pass.slot}</span></div>
              <div class="kv-row"><span class="kv-label">Noise Level</span><span class="kv-val">${pass.noise}</span></div>
              <div class="kv-row"><span class="kv-label">Facilities</span><span class="kv-val">${pass.facilities.join(', ')}</span></div>
            </div>

            <div style="display:flex;flex-direction:column;align-items:center;justify-content:center;background:var(--bg-subtle);border:1px solid var(--border-sage);border-radius:16px;padding:1.25rem;text-align:center;">
              <div style="background:#FFFFFF;padding:0.75rem;border-radius:12px;border:1px solid var(--border-sage);color:var(--ink-900);margin-bottom:0.75rem;">
                ${qrSvg(104)}
              </div>
              <div class="bold text-xs">Desk Check-In QR</div>
              <div class="text-xs subtle" style="margin-top:2px;">${pass.date} · Sample Demo Pass</div>
            </div>
          </div>
        </div>

        <div style="display:flex;flex-wrap:wrap;gap:0.75rem;">
          ${!isSaved ? `<button data-act="save-pass" class="btn-primary">✓ Confirm &amp; Save to My Profile</button>` : ''}
          <button data-act="add-study-rem" class="btn-sage">Add Study Reminder</button>
          <button data-act="copy-pass" class="btn-secondary">Copy Details to Share</button>
          ${isSaved ? `<button data-act="cancel-pass" data-id="${pass.bookingId}" class="btn-danger-soft">Cancel Booking</button>` : ''}
        </div>
      </div>
    `;
  },

  books() {
    const overdueCount = STATE.books.filter(b => b.dueOffset < 0 && !b.finePaid).length;
    const dueSoonCount = STATE.books.filter(b => b.dueOffset >= 0 && b.dueOffset <= 3).length;
    const totalFines = sumBy(STATE.books, getBookFine);
    const reminders = getAllReminders();

    const year = TODAY.getFullYear();
    const month = TODAY.getMonth();
    const firstWeekday = (new Date(year, month, 1).getDay() + 6) % 7;
    const daysInMonth = new Date(year, month + 1, 0).getDate();
    const eventsByDay = {};
    STATE.books.forEach(b => {
      const d = addDays(b.dueOffset);
      if (d.getMonth() === month && d.getFullYear() === year) {
        const day = d.getDate();
        if (!eventsByDay[day]) eventsByDay[day] = [];
        const st = getBookStatus(b);
        eventsByDay[day].push({
          color: st.key === 'overdue' ? 'var(--rose-ink)' : st.key === 'soon' ? 'var(--amber-ink)' : 'var(--emerald-ink)',
          text: `${b.title} (${st.label}${getBookFine(b) > 0 ? ', ₹' + getBookFine(b) : ''})`
        });
      }
    });
    STATE.bookings.forEach(bk => {
      const day = TODAY.getDate();
      if (!eventsByDay[day]) eventsByDay[day] = [];
      eventsByDay[day].push({ color: 'var(--sage-600)', text: `Seat ${bk.chairCode} at ${bk.spaceName} (${bk.slot})` });
    });

    const selectedDayEvents = eventsByDay[STATE.selectedCalDay] || [];

    return `
      <div class="view-enter">
        ${demoNoticeBar(`<span class="text-xs semibold" style="color:var(--sage-700);">Sample Fine Rate: ₹5 per overdue day</span>`)}

        <div class="page-head">
          <div>
            <span class="eyebrow-label">Library Accountability &amp; Alerts · Demo Data</span>
            <h1 class="page-title">Issued Books, Fines &amp; Smart Reminders</h1>
          </div>
          <button data-go="preference" class="btn-primary btn-sm">Find a Study Seat →</button>
        </div>

        <div class="grid-4" style="margin-bottom:1.5rem;">
          <div class="card kpi-card">
            <div class="kpi-label">Books Currently Issued</div>
            <div class="kpi-val">${STATE.books.length}</div>
            <div class="text-xs subtle" style="margin-top:4px;">Sample LPU Catalog</div>
          </div>
          <div class="card kpi-card">
            <div class="kpi-label">Overdue Books</div>
            <div class="kpi-val" style="color:var(--rose-dark);">${overdueCount}</div>
            <div class="text-xs" style="color:var(--rose-dark);margin-top:4px;">${overdueCount > 0 ? 'Action needed' : 'All clear'}</div>
          </div>
          <div class="card kpi-card">
            <div class="kpi-label">Due Within 3 Days</div>
            <div class="kpi-val" style="color:var(--amber-dark);">${dueSoonCount}</div>
            <div class="text-xs" style="color:var(--amber-dark);margin-top:4px;">Renew before due date</div>
          </div>
          <div class="card kpi-card">
            <div class="kpi-label">Total Pending Fines</div>
            <div class="kpi-val" style="color:${totalFines > 0 ? 'var(--rose-dark)' : 'var(--emerald-dark)'};">₹${totalFines}</div>
            <div class="text-xs subtle" style="margin-top:4px;">₹5 per day overdue</div>
          </div>
        </div>

        <div class="card" style="padding:1.5rem;margin-bottom:1.5rem;overflow:hidden;">
          <div style="padding-bottom:1rem;border-bottom:1px solid #E9EFEA;margin-bottom:1rem;">
            <h2 style="font-size:1.45rem;font-weight:500;">Issued Books &amp; Due Dates (Sample Data)</h2>
            <p class="text-xs muted" style="margin-top:0.25rem;">Renew eligible books by +7 days, settle overdue fines via demo payment, or set instant reminders.</p>
          </div>

          <div class="table-wrap">
            <table class="data-table">
              <thead>
                <tr>
                  <th>Book &amp; Call Number</th>
                  <th>Issued Date</th>
                  <th>Return Due Date</th>
                  <th>Status</th>
                  <th>Fine</th>
                  <th style="text-align:right;">Actions</th>
                </tr>
              </thead>
              <tbody>
                ${STATE.books.map(b => {
                  const st = getBookStatus(b);
                  const fine = getBookFine(b);
                  const absDays = Math.abs(b.dueOffset);
                  const daysText = b.dueOffset < 0
                    ? `${absDays} ${absDays === 1 ? 'day' : 'days'} overdue`
                    : b.dueOffset === 0
                      ? 'Due today'
                      : `${b.dueOffset} ${b.dueOffset === 1 ? 'day' : 'days'} remaining`;
                  return `
                    <tr>
                      <td>
                        <div class="bold text-sm" style="color:var(--ink-900);">${b.title}</div>
                        <div class="text-xs muted">${b.author} · <span style="font-family:monospace;color:var(--sage-700);">${b.callNo}</span></div>
                      </td>
                      <td class="muted" style="white-space:nowrap;">${fmtShortDate(addDays(b.issuedOffset))}</td>
                      <td style="white-space:nowrap;">
                        <div class="bold">${fmtShortDate(addDays(b.dueOffset))}</div>
                        <div class="text-xs" style="color:${b.dueOffset < 0 ? 'var(--rose-dark)' : 'var(--ink-500)'};">${daysText}</div>
                      </td>
                      <td style="white-space:nowrap;">
                        <span class="pill-tag ${st.cls}">${st.label}</span>
                      </td>
                      <td class="bold" style="white-space:nowrap;color:${fine > 0 ? 'var(--rose-dark)' : 'var(--emerald-dark)'};">₹${fine}</td>
                      <td style="text-align:right;white-space:nowrap;">
                        <div style="display:inline-flex;align-items:center;gap:0.4rem;">
                          ${fine > 0
                            ? `<button data-act="open-pay-modal" data-bk="${b.id}" class="btn-primary btn-sm" style="background:var(--rose-dark);border-color:var(--rose-dark);">Pay Fine (₹${fine})</button>`
                            : `<button data-act="renew-book" data-bk="${b.id}" class="btn-primary btn-sm">Renew (+7 days)</button>`}
                          <button data-act="quick-book-rem" data-bk="${b.id}" class="btn-secondary btn-sm" style="padding:0.42rem 0.65rem;" title="Set Reminder">🔔</button>
                        </div>
                      </td>
                    </tr>
                  `;
                }).join('')}
              </tbody>
            </table>
          </div>
        </div>

        <div class="split-12 ratio-7-5">
          <div class="stack-lg">
            <div class="card" style="padding:1.5rem;">
              <div class="flex-between" style="margin-bottom:1rem;">
                <div>
                  <h2 style="font-size:1.35rem;font-weight:500;">Smart Reminders &amp; Urgent Alerts</h2>
                  <p class="text-xs muted">Auto-synced with overdue fines, upcoming dues, and your seat bookings.</p>
                </div>
                <span class="pill-tag pill-sage">${reminders.length} Active</span>
              </div>

              ${reminders.length ? `
                <div class="stack-sm" style="margin-bottom:1.25rem;">
                  ${reminders.map(r => {
                    const dotColor = r.urgent === 'overdue' ? 'var(--rose-ink)' : r.urgent === 'soon' ? 'var(--amber-ink)' : r.urgent === 'booking' ? 'var(--sage-600)' : 'var(--ink-800)';
                    return `
                      <div style="padding:0.85rem 1rem;border-radius:14px;background:var(--bg-subtle);border:1px solid var(--border-sage);display:flex;align-items:flex-start;justify-content:space-between;gap:0.75rem;">
                        <div style="display:flex;align-items:flex-start;gap:0.65rem;">
                          <span style="width:8px;height:8px;border-radius:999px;margin-top:6px;flex-shrink:0;background:${dotColor};"></span>
                          <div>
                            <div class="semibold text-sm">${r.title}</div>
                            <div class="text-xs subtle" style="margin-top:2px;">${r.category} · ${r.when}</div>
                          </div>
                        </div>
                        <button data-act="dismiss-rem" data-id="${r.id}" data-auto="${r.auto}" class="btn-secondary btn-sm" style="flex-shrink:0;">Mark Done</button>
                      </div>
                    `;
                  }).join('')}
                </div>
              ` : `<div style="padding:1.5rem;text-align:center;font-size:0.8rem;color:var(--ink-500);background:var(--bg-subtle);border-radius:14px;margin-bottom:1.25rem;">All reminders completed.</div>`}

              <form id="add-reminder-form" style="padding:1rem;border-radius:16px;background:var(--bg-mist);border:1px solid var(--border-sage);" class="stack-sm">
                <span class="eyebrow-label" style="color:var(--ink-900);margin:0;">Add Custom Reminder</span>
                <input id="rem-title" class="field-input" type="text" required placeholder="e.g., Return CLRS textbook before lab...">
                <div class="grid-2" style="gap:0.6rem;">
                  <select id="rem-cat" class="field-select">
                    <option value="Book Due">Book Due</option>
                    <option value="Fine Payment">Fine Payment</option>
                    <option value="Study Session">Study Session</option>
                  </select>
                  <input id="rem-when" class="field-input" type="datetime-local">
                </div>
                <button type="submit" class="btn-primary btn-sm">+ Add Reminder</button>
              </form>
            </div>

            <div class="card" style="padding:1.5rem;">
              <h2 style="font-size:1.35rem;font-weight:500;">Automated Reminder Channels (Demo)</h2>
              <p class="text-xs muted" style="margin:0.25rem 0 1rem;">Choose how you want LPU Library to notify you before due dates.</p>
              <div class="stack-sm">
                ${[
                  ['whatsapp', 'WhatsApp Due Alerts', 'Instant reminders 48 hours before book expiry & fine receipts'],
                  ['email', 'LPU Email Digest', 'Weekly summary sent to ' + getProfile().email],
                  ['push', 'Browser Push Notifications', 'Desktop & mobile alerts for upcoming study session slots']
                ].map(([key, title, desc]) => {
                  const on = STATE.channels[key];
                  return `
                    <div style="display:flex;align-items:center;justify-content:space-between;gap:1rem;padding:0.85rem 1rem;border-radius:14px;background:var(--bg-subtle);border:1px solid var(--border-sage);">
                      <div>
                        <div class="bold text-xs">${title}</div>
                        <div class="text-xs muted">${desc}</div>
                      </div>
                      <button type="button" data-act="toggle-channel" data-ch="${key}" class="switch-track ${on ? 'on' : ''}" aria-pressed="${on}">
                        <span class="switch-thumb"></span>
                      </button>
                    </div>
                  `;
                }).join('')}
              </div>
            </div>
          </div>

          <div class="card" style="padding:1.5rem;">
            <div class="flex-between" style="margin-bottom:0.85rem;">
              <h2 style="font-size:1.35rem;font-weight:500;">${TODAY.toLocaleDateString('en-GB', { month: 'long', year: 'numeric' })}</h2>
              <span class="text-xs semibold" style="color:var(--sage-700);">Click any dotted date</span>
            </div>

            <div class="cal-grid" style="font-size:0.7rem;font-weight:700;color:var(--ink-500);margin-bottom:0.45rem;">
              ${['M','T','W','T','F','S','S'].map(d => `<div>${d}</div>`).join('')}
            </div>

            <div class="cal-grid">
              ${'<div></div>'.repeat(firstWeekday)}
              ${Array.from({ length: daysInMonth }, (_, i) => {
                const day = i + 1;
                const isToday = day === TODAY.getDate();
                const isSel = day === STATE.selectedCalDay;
                const evs = eventsByDay[day] || [];
                return `
                  <button data-act="select-cal-day" data-day="${day}" class="cal-day-btn ${isSel ? 'selected' : isToday ? 'today' : ''}">
                    <span>${day}</span>
                    <span class="cal-dots">
                      ${evs.slice(0, 3).map(ev => `<span class="cal-dot" style="background:${isSel ? '#FFFFFF' : ev.color};"></span>`).join('')}
                    </span>
                  </button>
                `;
              }).join('')}
            </div>

            <div style="margin-top:1rem;padding-top:1rem;border-top:1px solid #E9EFEA;">
              <div class="bold text-xs" style="margin-bottom:0.5rem;">Events on ${STATE.selectedCalDay} ${TODAY.toLocaleDateString('en-GB', { month: 'short' })}</div>
              ${selectedDayEvents.length ? `
                <div class="stack-sm">
                  ${selectedDayEvents.map(ev => `
                    <div style="padding:0.6rem 0.75rem;border-radius:11px;background:var(--bg-subtle);border:1px solid var(--border-sage);display:flex;align-items:center;gap:0.5rem;font-size:0.76rem;">
                      <span style="width:8px;height:8px;border-radius:999px;flex-shrink:0;background:${ev.color};"></span>
                      <span>${ev.text}</span>
                    </div>
                  `).join('')}
                </div>
              ` : `<div class="text-xs subtle">No book dues or seat bookings on this date.</div>`}
            </div>

            <div style="display:flex;flex-wrap:wrap;gap:0.75rem;margin-top:1rem;padding-top:0.75rem;border-top:1px solid #E9EFEA;font-size:0.68rem;color:var(--ink-600);">
              <span><span style="color:var(--rose-ink);">●</span> Overdue</span>
              <span><span style="color:var(--amber-ink);">●</span> Due Soon</span>
              <span><span style="color:var(--emerald-ink);">●</span> On Time</span>
              <span><span style="color:var(--sage-600);">●</span> Seat Booked</span>
            </div>
          </div>
        </div>
      </div>
    `;
  },

  profile() {
    const prof = getProfile();
    const totalFines = sumBy(STATE.books, getBookFine);
    const overdueCount = STATE.books.filter(b => b.dueOffset < 0 && !b.finePaid).length;

    return `
      <div class="view-enter narrow-wrap">
        ${demoNoticeBar()}

        <div class="page-head">
          <div>
            <span class="eyebrow-label">Digital Campus Identity</span>
            <h1 class="page-title">Student &amp; Faculty Profile</h1>
          </div>
          <div class="role-switch">
            <button data-act="set-role" data-role="student" class="role-btn ${STATE.role === 'student' ? 'active' : ''}">Student View</button>
            <button data-act="set-role" data-role="faculty" class="role-btn ${STATE.role === 'faculty' ? 'active' : ''}">Faculty View</button>
          </div>
        </div>

        <div class="split-12 ratio-5-7">
          <div class="stack-lg">
            <div class="id-card-dark">
              <div class="flex-between" style="padding-bottom:1rem;margin-bottom:1rem;border-bottom:1px solid rgba(255,255,255,0.15);">
                <div>
                  <div style="font-size:0.65rem;font-weight:700;text-transform:uppercase;letter-spacing:0.14em;color:#B8CEC3;">Lovely Professional University</div>
                  <div style="font-size:0.75rem;color:#93B0A2;">Sample Digital Study Pass</div>
                </div>
                <span class="pill-tag" style="background:rgba(255,255,255,0.12);border:1px solid rgba(255,255,255,0.2);color:#FFFFFF;">${prof.roleLabel}</span>
              </div>

              <div style="display:flex;align-items:center;gap:1rem;margin-bottom:1.25rem;">
                <div class="font-serif" style="width:56px;height:56px;border-radius:16px;background:var(--bg-canvas);color:var(--ink-900);font-size:1.5rem;font-weight:600;display:flex;align-items:center;justify-content:center;flex-shrink:0;">${prof.initials}</div>
                <div>
                  <h2 style="font-size:1.5rem;font-weight:500;color:#FFFFFF;">${prof.name}</h2>
                  <div style="font-size:0.76rem;color:#C7D9D0;">${prof.department}</div>
                  <div style="font-size:0.7rem;color:#93B0A2;margin-top:2px;">${prof.meta}</div>
                </div>
              </div>

              <div style="background:rgba(255,255,255,0.1);border:1px solid rgba(255,255,255,0.16);border-radius:16px;padding:0.9rem;display:flex;align-items:center;justify-content:space-between;gap:0.75rem;">
                <div>
                  <div style="font-size:0.64rem;text-transform:uppercase;letter-spacing:0.12em;color:#B8CEC3;">University ID</div>
                  <div style="font-family:monospace;font-weight:700;font-size:0.95rem;margin-top:2px;">${prof.idNumber}</div>
                  <div style="font-size:0.7rem;color:#C7D9D0;margin-top:2px;">${prof.email}</div>
                </div>
                <div style="background:#FFFFFF;padding:6px;border-radius:11px;color:var(--ink-900);flex-shrink:0;">
                  ${qrSvg(64)}
                </div>
              </div>
            </div>

            <div class="card stack-md" style="padding:1.5rem;">
              <h3 style="font-size:1.3rem;font-weight:500;">Editable Study Preferences</h3>
              <div>
                <label class="block text-xs semibold muted" style="display:block;margin-bottom:4px;">Default Mode</label>
                <select id="pref-mode" class="field-select">
                  <option value="solo" ${prof.defaultMode === 'solo' ? 'selected' : ''}>Solo Study</option>
                  <option value="group" ${prof.defaultMode === 'group' ? 'selected' : ''}>Group Study</option>
                </select>
              </div>
              <div>
                <label class="block text-xs semibold muted" style="display:block;margin-bottom:4px;">Preferred Building</label>
                <select id="pref-bld" class="field-select">
                  ${BUILDINGS.map(b => `<option value="${b.id}" ${prof.defaultBuilding === b.id ? 'selected' : ''}>${b.name} (${b.block})</option>`).join('')}
                </select>
              </div>
              <div>
                <label class="block text-xs semibold muted" style="display:block;margin-bottom:4px;">Preferred Noise Level</label>
                <select id="pref-noise" class="field-select">
                  ${['Any', 'Silent', 'Quiet'].map(n => `<option value="${n}" ${prof.defaultNoise === n ? 'selected' : ''}>${n}</option>`).join('')}
                </select>
              </div>
              <button data-act="save-prefs" class="btn-primary" style="width:100%;">Save Study Preferences</button>
            </div>
          </div>

          <div class="stack-lg">
            <div class="grid-2">
              <div class="card" style="padding:1.25rem;">
                <div class="kpi-label">Active Seat Bookings</div>
                <div class="kpi-val">${STATE.bookings.length}</div>
                <button data-go="location" class="text-xs semibold" style="color:var(--sage-700);margin-top:0.5rem;">Book a new seat →</button>
              </div>
              <div class="card" style="padding:1.25rem;">
                <div class="kpi-label">Pending Library Dues</div>
                <div class="kpi-val" style="color:${totalFines > 0 ? 'var(--rose-dark)' : 'var(--emerald-dark)'};">₹${totalFines} <span style="font-family:var(--font-sans);font-size:0.75rem;color:var(--ink-500);">(${overdueCount} overdue)</span></div>
                <button data-go="books" class="text-xs semibold" style="color:var(--sage-700);margin-top:0.5rem;">Open Books &amp; Reminders →</button>
              </div>
            </div>

            <div class="card" style="padding:1.5rem;">
              <div style="padding-bottom:0.85rem;border-bottom:1px solid #E9EFEA;margin-bottom:1rem;">
                <h2 style="font-size:1.35rem;font-weight:500;">Active Seat Booking Passes</h2>
                <p class="text-xs muted" style="margin-top:2px;">Cancelling a booking immediately frees the chair back to green.</p>
              </div>

              ${STATE.bookings.length ? `
                <div class="stack-sm">
                  ${STATE.bookings.map(bk => `
                    <div style="padding:1rem;border-radius:14px;background:var(--bg-subtle);border:1px solid var(--border-sage);display:flex;flex-wrap:wrap;align-items:center;justify-content:space-between;gap:0.75rem;">
                      <div>
                        <div style="display:flex;align-items:center;gap:0.5rem;">
                          <span class="pill-tag pill-ink">Seat ${bk.chairCode}</span>
                          <strong class="text-sm">${bk.spaceName}</strong>
                        </div>
                        <div class="text-xs muted" style="margin-top:4px;">${bk.buildingName} (${bk.block}) · Floor ${bk.floor}</div>
                        <div class="text-xs subtle" style="margin-top:2px;">${bk.slot}</div>
                      </div>
                      <div style="display:flex;gap:0.45rem;">
                        <button data-act="view-pass" data-id="${bk.bookingId}" class="btn-secondary btn-sm">QR Pass</button>
                        <button data-act="cancel-pass" data-id="${bk.bookingId}" class="btn-danger-soft btn-sm">Cancel</button>
                      </div>
                    </div>
                  `).join('')}
                </div>
              ` : `
                <div style="text-align:center;padding:2rem 1rem;">
                  <div class="tile-num" style="margin-bottom:0.35rem;">Empty Log</div>
                  <div class="semibold text-sm">No Active Seat Passes</div>
                  <p class="text-xs muted" style="margin:0.3rem 0 1rem;">Explore any building floor to reserve a vacant chair.</p>
                  <button data-go="preference" class="btn-primary btn-sm">Find a Seat →</button>
                </div>
              `}
            </div>
          </div>
        </div>
      </div>
    `;
  },

  flow() {
    const nodes = [
      { n: '01', id: 'home', t: 'Overview', d: 'Clear purpose, 3-step guide & snapshot' },
      { n: '02', id: 'preference', t: 'Study Preferences', d: 'Role, Solo/Group & Noise' },
      { n: '03', id: 'location', t: 'Building & Floor', d: '4 LPU blocks & floor elevations' },
      { n: '04', id: 'occupancy', t: 'Seat Availability', d: 'Floor interior green/red chairs' },
      { n: '05', id: 'details', t: 'Space Details', d: 'Facilities & study session time slots' },
      { n: '06', id: 'final', t: 'Digital Pass', d: 'QR pass, save & share' }
    ];
    const donePct = Math.round((STATE.completedTasks.length / CP5_TASKS.length) * 100);

    return `
      <div class="view-enter narrow-wrap">
        ${demoNoticeBar()}

        <div class="page-head">
          <div>
            <span class="eyebrow-label">INT335 Design Thinking · CP5 Deliverable</span>
            <h1 class="page-title">Interactive User Flow &amp; Usability Testing</h1>
            <p class="page-sub">Click any node in the flow diagram to open that screen, and track usability test completion below.</p>
          </div>
        </div>

        <div class="card" style="padding:1.5rem;margin-bottom:1.5rem;">
          <h2 style="font-size:1.35rem;font-weight:500;margin-bottom:1rem;">Connected 6-Screen User Flow + Side Paths</h2>
          <div class="grid-3" style="margin-bottom:1.25rem;">
            ${nodes.map(nd => `
              <button data-go="${nd.id}" class="card card-hover" style="padding:1rem;text-align:left;display:flex;align-items:flex-start;gap:0.75rem;">
                <span class="tile-num" style="font-size:1.1rem;">${nd.n}</span>
                <div>
                  <div class="bold text-sm">${nd.t}</div>
                  <div class="text-xs muted" style="margin-top:2px;">${nd.d}</div>
                </div>
              </button>
            `).join('')}
          </div>

          <div class="grid-2" style="padding-top:1rem;border-top:1px solid #E9EFEA;">
            <button data-go="books" style="padding:1rem;border-radius:14px;background:var(--bg-sage-tint);border:1px solid var(--sage-200);display:flex;align-items:center;justify-content:space-between;text-align:left;">
              <div>
                <span class="eyebrow-label" style="margin-bottom:2px;color:var(--sage-700);">Side Path A</span>
                <div class="bold text-sm">Books, Fines &amp; Smart Reminders</div>
              </div>
              <span class="bold">→</span>
            </button>
            <button data-go="profile" style="padding:1rem;border-radius:14px;background:var(--bg-subtle);border:1px solid var(--border-sage);display:flex;align-items:center;justify-content:space-between;text-align:left;">
              <div>
                <span class="eyebrow-label" style="margin-bottom:2px;color:var(--ink-500);">Side Path B</span>
                <div class="bold text-sm">Digital Student / Faculty Profile &amp; ID</div>
              </div>
              <span class="bold">→</span>
            </button>
          </div>
        </div>

        <div class="card" style="padding:1.5rem;">
          <div class="flex-between" style="margin-bottom:0.85rem;">
            <div>
              <h2 style="font-size:1.35rem;font-weight:500;">CP5 Usability Testing Checklist</h2>
              <p class="text-xs muted">Check off tasks as LPU students and teachers complete them during testing.</p>
            </div>
            <span class="pill-tag pill-sage">${STATE.completedTasks.length} of ${CP5_TASKS.length} Completed (${donePct}%)</span>
          </div>

          <div style="width:100%;height:8px;background:var(--bg-mist);border-radius:999px;overflow:hidden;margin-bottom:1.25rem;">
            <div style="width:${donePct}%;height:100%;background:var(--ink-800);border-radius:999px;transition:width 0.3s ease;"></div>
          </div>

          <div class="stack-sm">
            ${CP5_TASKS.map((t, idx) => {
              const checked = STATE.completedTasks.includes(t.id);
              return `
                <button data-act="toggle-task" data-id="${t.id}" style="width:100%;padding:0.95rem 1rem;border-radius:14px;border:1px solid ${checked ? 'var(--emerald-border)' : 'var(--border-sage)'};background:${checked ? 'var(--emerald-soft)' : 'var(--bg-subtle)'};display:flex;align-items:flex-start;gap:0.75rem;text-align:left;">
                  <span style="width:24px;height:24px;border-radius:999px;display:flex;align-items:center;justify-content:center;font-size:0.72rem;font-weight:700;flex-shrink:0;margin-top:1px;background:${checked ? 'var(--emerald-dark)' : 'var(--bg-white)'};color:${checked ? '#FFFFFF' : 'var(--ink-500)'};border:1px solid ${checked ? 'var(--emerald-dark)' : 'var(--border-sage)'};">${checked ? '✓' : idx + 1}</span>
                  <span class="text-sm" style="${checked ? 'text-decoration:line-through;color:var(--emerald-dark);opacity:0.8;' : 'color:var(--ink-900);'}">${t.text}</span>
                </button>
              `;
            }).join('')}
          </div>
        </div>
      </div>
    `;
  }
};

function renderModal() {
  const root = document.getElementById('modal-root');
  if (!STATE.paymentModalBookId) {
    root.innerHTML = '';
    return;
  }
  const book = STATE.books.find(b => b.id === STATE.paymentModalBookId);
  if (!book) {
    root.innerHTML = '';
    return;
  }
  const fine = getBookFine(book);
  const absDays = Math.abs(book.dueOffset);
  root.innerHTML = `
    <div class="modal-backdrop">
      <div class="card modal-box view-enter">
        <div class="flex-between" style="padding-bottom:0.85rem;border-bottom:1px solid #E9EFEA;margin-bottom:1rem;">
          <div>
            <span class="eyebrow-label" style="margin-bottom:2px;">LPU Demo Fine Settlement</span>
            <h3 style="font-size:1.4rem;font-weight:500;">Pay Overdue Library Fine</h3>
          </div>
          <button data-act="close-pay-modal" class="icon-pill-btn" style="width:32px;height:32px;font-size:0.8rem;">✕</button>
        </div>

        <div style="padding:0.9rem 1rem;border-radius:14px;background:var(--rose-soft);border:1px solid var(--rose-border);margin-bottom:1rem;">
          <div class="bold text-xs">${book.title}</div>
          <div class="flex-between" style="margin-top:0.4rem;">
            <span class="text-xs" style="color:var(--rose-dark);">${absDays} ${absDays === 1 ? 'day' : 'days'} overdue × ₹5 per day</span>
            <strong class="font-serif" style="font-size:1.35rem;color:var(--rose-dark);">₹${fine}</strong>
          </div>
        </div>

        <div class="text-xs semibold muted" style="margin-bottom:0.5rem;">Select Demo Payment Method</div>
        <div class="grid-3" style="gap:0.5rem;margin-bottom:1.25rem;">
          ${['UPI', 'Campus Wallet', 'Card'].map(m => `
            <button data-act="set-pay-method" data-val="${m}" class="chip-btn" style="padding:0.55rem 0.4rem;text-align:center;${STATE.paymentMethod === m ? 'background:var(--ink-800);color:#FFFFFF;border-color:var(--ink-800);' : ''}">${m}</button>
          `).join('')}
        </div>

        <div style="display:flex;gap:0.65rem;">
          <button data-act="close-pay-modal" class="btn-secondary" style="flex:1;">Cancel</button>
          <button data-act="confirm-pay-fine" data-bk="${book.id}" class="btn-primary" style="flex:1;">Pay ₹${fine} Now (Demo)</button>
        </div>
      </div>
    </div>
  `;
}

function renderApp(keepScroll = false) {
  const shell = document.getElementById('app-shell');

  if (STATE.screen === 'home') {
    shell.innerHTML = `${renderHeader()}<main style="flex:1;padding-bottom:3.5rem;">${VIEWS.home()}</main>${renderMobileBottomNav()}`;
  } else {
    shell.innerHTML = `
      ${renderHeader()}
      <main class="container workspace-main">
        ${VIEWS[STATE.screen]()}
      </main>
      ${renderMobileBottomNav()}
    `;
  }

  renderModal();
  if (!keepScroll) window.scrollTo({ top: 0, behavior: 'smooth' });
}

function copyText(text) {
  const ta = document.createElement('textarea');
  ta.value = text;
  ta.style.position = 'fixed';
  ta.style.opacity = '0';
  document.body.appendChild(ta);
  ta.select();
  try {
    document.execCommand('copy');
    showToast('Details Copied', 'Ready to paste into WhatsApp or Teams.', 'green');
  } catch (err) {
    showToast('Copy Unavailable', 'Please copy the pass details manually.', 'amber');
  }
  ta.remove();
}

document.addEventListener('click', (e) => {
  const goEl = e.target.closest('[data-go]');
  if (goEl) {
    STATE.screen = goEl.dataset.go;
    renderApp(false);
    return;
  }

  const actEl = e.target.closest('[data-act]');
  if (!actEl || actEl.disabled) return;
  const act = actEl.dataset.act;

  if (act === 'set-role') {
    STATE.role = actEl.dataset.role;
    showToast(`Switched to ${getProfile().roleLabel}`, `Signed in as ${getProfile().name} (${getProfile().idNumber})`, 'sage');
    renderApp(true);
  }
  else if (act === 'toggle-faq') {
    const idx = Number(actEl.dataset.idx);
    STATE.openFaq = STATE.openFaq === idx ? -1 : idx;
    renderApp(true);
  }
  else if (act === 'set-mode') { STATE.mode = actEl.dataset.mode; renderApp(true); }
  else if (act === 'set-noise') { STATE.noise = actEl.dataset.val; renderApp(true); }
  else if (act === 'set-size') { STATE.groupSize = Number(actEl.dataset.val); renderApp(true); }
  else if (act === 'jump-bld') { STATE.buildingId = actEl.dataset.bld; STATE.floor = 1; STATE.screen = 'location'; renderApp(false); }
  else if (act === 'focus-bld') { STATE.buildingId = actEl.dataset.bld; STATE.floor = 1; renderApp(true); }
  else if (act === 'switch-bld-quick') {
    STATE.buildingId = actEl.dataset.bld;
    STATE.floor = 1;
    STATE.floorFilter = 'all';
    const list = accessibleSpaces(SPACES.filter(s => s.bld === STATE.buildingId && s.floor === 1));
    if (list.length) STATE.activeSpaceId = list[0].id;
    STATE.selectedChair = null;
    renderApp(true);
  }
  else if (act === 'enter-floor') {
    STATE.buildingId = actEl.dataset.bld || STATE.buildingId;
    STATE.floor = Number(actEl.dataset.fl);
    STATE.floorFilter = 'all';
    const list = accessibleSpaces(SPACES.filter(s => s.bld === STATE.buildingId && s.floor === STATE.floor));
    if (list.length) STATE.activeSpaceId = list[0].id;
    STATE.selectedChair = null;
    STATE.screen = 'occupancy';
    renderApp(false);
  }
  else if (act === 'set-floor-filter') { STATE.floorFilter = actEl.dataset.val; renderApp(true); }
  else if (act === 'select-space') { STATE.activeSpaceId = actEl.dataset.sp; STATE.selectedChair = null; renderApp(true); }
  else if (act === 'pick-chair') {
    const { sp, ch, code } = actEl.dataset;
    STATE.selectedChair = (STATE.selectedChair && STATE.selectedChair.chairId === ch) ? null : { spaceId: sp, chairId: ch, code };
    renderApp(true);
  }
  else if (act === 'open-details') { STATE.activeSpaceId = actEl.dataset.sp; STATE.screen = 'details'; renderApp(false); }
  else if (act === 'set-slot') { STATE.timeSlot = actEl.dataset.val; renderApp(true); }
  else if (act === 'proceed-final') {
    const sp = getSpace(STATE.activeSpaceId);
    const bld = getBuilding(sp.bld);
    const prof = getProfile();
    const chair = STATE.selectedChair && STATE.selectedChair.spaceId === sp.id
      ? sp.chairs.find(c => c.id === STATE.selectedChair.chairId)
      : sp.chairs.find(c => c.status === 'vacant');
    if (!chair || chair.status !== 'vacant') {
      showToast('Select a Vacant Chair', 'Please pick a green vacant chair first.', 'amber');
      return;
    }
    STATE.lastPass = {
      bookingId: 'LPU-' + Math.floor(1000 + Math.random() * 9000),
      userName: prof.name,
      userId: prof.idNumber,
      buildingId: bld.id,
      buildingName: bld.name,
      block: bld.block,
      floor: sp.floor,
      spaceId: sp.id,
      spaceName: sp.name,
      chairId: chair.id,
      chairCode: chair.code,
      slot: STATE.timeSlot,
      date: fmtDate(TODAY),
      noise: sp.noise,
      facilities: sp.facilities
    };
    STATE.screen = 'final';
    renderApp(false);
  }
  else if (act === 'save-pass') {
    const pass = STATE.lastPass;
    if (!pass) return;
    const sp = getSpace(pass.spaceId);
    const ch = sp.chairs.find(c => c.id === pass.chairId);
    if (ch) ch.status = 'mine';
    if (!STATE.bookings.some(b => b.bookingId === pass.bookingId)) {
      STATE.bookings.unshift(pass);
    }
    STATE.selectedChair = null;
    showToast(`Seat ${pass.chairCode} Saved`, `${pass.spaceName} added to your Profile & Reminders.`, 'green');
    renderApp(true);
  }
  else if (act === 'add-study-rem') {
    const pass = STATE.lastPass || STATE.bookings[0];
    if (!pass) return;
    STATE.customReminders.unshift({
      id: 'rem-' + Date.now(),
      title: `Study session at ${pass.spaceName} (Seat ${pass.chairCode}, ${pass.buildingName})`,
      category: 'Study Session',
      when: pass.slot,
      done: false
    });
    showToast('Study Reminder Added', 'View it anytime under Books & Reminders.', 'sage');
    renderApp(true);
  }
  else if (act === 'copy-pass') {
    const pass = STATE.lastPass || STATE.bookings[0];
    if (!pass) return;
    copyText(`A Seat to Study (LPU Demo Pass)\nPass: ${pass.bookingId}\nSpace: ${pass.spaceName} — Seat ${pass.chairCode}\nLocation: ${pass.buildingName} (${pass.block}), Floor ${pass.floor}\nStudy Session: ${pass.slot}\nFacilities: ${pass.facilities.join(', ')}`);
  }
  else if (act === 'view-pass') {
    const found = STATE.bookings.find(b => b.bookingId === actEl.dataset.id);
    if (found) { STATE.lastPass = found; STATE.screen = 'final'; renderApp(false); }
  }
  else if (act === 'cancel-pass') {
    const id = actEl.dataset.id;
    const idx = STATE.bookings.findIndex(b => b.bookingId === id);
    if (idx >= 0) {
      const bk = STATE.bookings[idx];
      const sp = getSpace(bk.spaceId);
      const ch = sp.chairs.find(c => c.id === bk.chairId);
      if (ch) ch.status = 'vacant';
      STATE.bookings.splice(idx, 1);
      if (STATE.lastPass && STATE.lastPass.bookingId === id) STATE.lastPass = STATE.bookings[0] || null;
      showToast('Booking Cancelled', `Seat ${bk.chairCode} is now vacant and green again.`, 'amber');
      renderApp(true);
    }
  }
  else if (act === 'refresh-demo') {
    SPACES.forEach(sp => {
      sp.chairs.forEach(ch => {
        if (ch.status !== 'mine' && Math.random() < 0.16) {
          ch.status = ch.status === 'vacant' ? 'booked' : 'vacant';
        }
      });
    });
    STATE.lastRefreshed = fmtTimeNow();
    STATE.selectedChair = null;
    showToast('Sample Occupancy Refreshed', `Updated sample chair counts at ${STATE.lastRefreshed}.`, 'sage');
    renderApp(true);
  }
  else if (act === 'renew-book') {
    const bk = STATE.books.find(b => b.id === actEl.dataset.bk);
    if (bk) {
      bk.dueOffset = Math.max(bk.dueOffset, 0) + 7;
      showToast('Book Renewed (+7 Days)', `${bk.title} is now due ${fmtShortDate(addDays(bk.dueOffset))}.`, 'green');
      renderApp(true);
    }
  }
  else if (act === 'open-pay-modal') {
    STATE.paymentModalBookId = actEl.dataset.bk;
    renderModal();
  }
  else if (act === 'close-pay-modal') {
    STATE.paymentModalBookId = null;
    renderModal();
  }
  else if (act === 'set-pay-method') {
    STATE.paymentMethod = actEl.dataset.val;
    renderModal();
  }
  else if (act === 'confirm-pay-fine') {
    const bk = STATE.books.find(b => b.id === actEl.dataset.bk);
    if (bk) {
      const paidAmt = getBookFine(bk);
      bk.finePaid = true;
      STATE.paymentModalBookId = null;
      showToast(`Fine Paid (₹${paidAmt})`, `Settled via ${STATE.paymentMethod}. Renewal (+7 days) is now unlocked.`, 'green');
      renderApp(true);
    }
  }
  else if (act === 'quick-book-rem') {
    const bk = STATE.books.find(b => b.id === actEl.dataset.bk);
    if (bk) {
      STATE.customReminders.unshift({
        id: 'rem-' + Date.now(),
        title: `Return or renew "${bk.title}" (${bk.callNo})`,
        category: 'Book Due',
        when: `Due ${fmtShortDate(addDays(bk.dueOffset))}`,
        done: false
      });
      showToast('Book Reminder Set', `Added alert for ${bk.title}.`, 'sage');
      renderApp(true);
    }
  }
  else if (act === 'dismiss-rem') {
    const id = actEl.dataset.id;
    if (actEl.dataset.auto === 'true') {
      STATE.dismissedAutoIds.push(id);
    } else {
      const found = STATE.customReminders.find(r => r.id === id);
      if (found) found.done = true;
    }
    showToast('Reminder Marked Done', '', 'green');
    renderApp(true);
  }
  else if (act === 'toggle-channel') {
    const ch = actEl.dataset.ch;
    STATE.channels[ch] = !STATE.channels[ch];
    showToast(`${ch.toUpperCase()} Alerts ${STATE.channels[ch] ? 'Enabled' : 'Paused'}`, 'Demo preference updated.', 'sage');
    renderApp(true);
  }
  else if (act === 'select-cal-day') {
    STATE.selectedCalDay = Number(actEl.dataset.day);
    renderApp(true);
  }
  else if (act === 'save-prefs') {
    const p = PROFILES[STATE.role];
    const m = document.getElementById('pref-mode');
    const b = document.getElementById('pref-bld');
    const n = document.getElementById('pref-noise');
    if (m) { p.defaultMode = m.value; STATE.mode = m.value; }
    if (b) { p.defaultBuilding = b.value; STATE.buildingId = b.value; }
    if (n) { p.defaultNoise = n.value; STATE.noise = n.value; }
    showToast('Preferences Saved', `Defaults updated for ${p.name}.`, 'green');
  }
  else if (act === 'toggle-task') {
    const id = actEl.dataset.id;
    STATE.completedTasks = STATE.completedTasks.includes(id)
      ? STATE.completedTasks.filter(x => x !== id)
      : [...STATE.completedTasks, id];
    renderApp(true);
  }
});

document.addEventListener('submit', (e) => {
  if (e.target.id === 'add-reminder-form') {
    e.preventDefault();
    const title = document.getElementById('rem-title').value.trim();
    const cat = document.getElementById('rem-cat').value;
    const rawWhen = document.getElementById('rem-when').value;
    if (!title) return;
    const whenText = rawWhen ? new Date(rawWhen).toLocaleString('en-US', { day: '2-digit', month: 'short', hour: '2-digit', minute: '2-digit', hour12: true }) : fmtShortDate(TODAY);
    STATE.customReminders.unshift({ id: 'rem-' + Date.now(), title, category: cat, when: whenText, done: false });
    showToast('Custom Reminder Added', `${cat} · ${whenText}`, 'green');
    renderApp(true);
  }
  else if (e.target.id === 'quick-search-form') {
    e.preventDefault();
    const q = document.getElementById('quick-search-input').value.trim().toLowerCase();
    STATE.searchQuery = q;
    if (!q) return;
    const sp = accessibleSpaces(SPACES).find(s => s.name.toLowerCase().includes(q));
    if (sp) {
      STATE.buildingId = sp.bld;
      STATE.floor = sp.floor;
      STATE.activeSpaceId = sp.id;
      STATE.screen = 'details';
      showToast(`Opened ${sp.name}`, `${getBuilding(sp.bld).name}, Floor ${sp.floor}`, 'sage');
      renderApp(false);
      return;
    }
    const bk = STATE.books.find(b => b.title.toLowerCase().includes(q));
    if (bk) {
      STATE.screen = 'books';
      showToast('Found Book', bk.title, 'sage');
      renderApp(false);
      return;
    }
    showToast('No Exact Match', 'Try searching "Reading", "Pods", or "Algorithms".', 'amber');
  }
});

renderApp(true);
</script>
</body>
</html>
